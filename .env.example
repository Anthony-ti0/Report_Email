MEF_DB_SERVER=
MEF_DB_NAME=
MEF_DB_UID=
MEF_DB_PWD=

MEF_GCHAT_WEBHOOK_URL=
# IDs separados por vírgula. Segunda a sábado usa USER_IDS_SEMANA; domingo usa USER_IDS_DOMINGO.
MEF_GCHAT_MENTION_USER_IDS_SEMANA=
MEF_GCHAT_MENTION_USER_IDS_DOMINGO=

MEF_SMTP_HOST=
MEF_SMTP_PORT=
MEF_SMTP_USER=
MEF_SMTP_PASSWORD=

MEF_VALIDATION_EMAIL_TO=

# Opcional: caminho base das remessas no Drive e do PNG de validação
MEF_DRIVE_REMESSAS_PATH=
MEF_VALIDATION_PNG_PATH=

# Batimento TIM JCA
MEF_DRIVE_JCA_PATH=
# IDs separados por vírgula, lista fixa (não varia por dia da semana)
MEF_GCHAT_MENTION_USER_IDS_BATIMENTO_JCA=
# Opcional: arquivo-marcador para não reenviar o report no mesmo dia
MEF_BATIMENTO_JCA_MARKER_PATH=

# Teste: report com imagem via CardsV2 (main_com_imagem / --cardv2)
MEF_BATIMENTO_JCA_PNG_PATH=
# Opcional: marcador separado do fluxo de texto, para as duas variantes coexistirem
MEF_BATIMENTO_JCA_IMG_MARKER_PATH=
# Opcional: se preenchida, usa essa URL de imagem direto (sem subir ao Drive) —
# útil pra testar o CardsV2 antes de ter a conta de serviço do Drive configurada
MEF_BATIMENTO_JCA_IMAGE_URL=
# Caminho local do JSON da conta de serviço com acesso à Drive API (só é
# usado se MEF_BATIMENTO_JCA_IMAGE_URL estiver vazia)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# ID da pasta do Drive (compartilhada com o e-mail da conta de serviço) onde o PNG será publicado
GOOGLE_DRIVE_FOLDER_ID=
